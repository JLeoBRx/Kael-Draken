{
  "name": "kael-draken-arquivo",
  "version": "0.1.0",
  "private": true,
  "description": "Kael Draken — O Arquivo da Chama Antiga: enciclopédia, atlas e painel editorial do universo.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "admin:hash": "tsx scripts/hash-password.ts",
    "art": "python3 scripts/art/world.py && python3 scripts/art/scenes.py && python3 scripts/art/emblems.py && node scripts/art/panel.mjs",
    "art:mapas": "python3 scripts/art/world.py",
    "art:regioes": "python3 scripts/art/world.py --regenerar"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "image-size": "^2.0.4",
    "marked": "^18.1.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
