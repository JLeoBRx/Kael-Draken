# Copie para ".env" (na pasta do docker-compose.yml) e ajuste.

# Segredo compartilhado entre a plataforma e os nós (bilhetes de entrada e registro dos nós).
# Gere um com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PLATFORM_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Versão da imagem (tag)
UC_VERSION=1.0.0

# Porta da plataforma no computador (sem TLS)
PLATFORM_PORT=7370

# Região dos nós e da plataforma (sa, na, eu)
NODE_REGION=sa
# Servidores de jogo por nó e na própria plataforma (reserva)
NODE_CAPACITY=4
LOCAL_SERVERS=2

# Endereços que os NAVEGADORES usam para chegar aos nós (sem TLS).
# Em outra máquina da rede, troque localhost pelo IP deste servidor.
NODE1_PUBLIC_URL=ws://localhost:7381
NODE2_PUBLIC_URL=ws://localhost:7382

# Com TLS (deploy/docker-compose.tls.yml): domínio que aponta para esta máquina
# UC_DOMAIN=jogo.exemplo.com.br

# Protege /metrics com "Authorization: Bearer <token>" (vazio = aberto na rede interna)
METRICS_TOKEN=

# Quanto um nó espera as partidas terminarem ao ser desligado (segundos)
DRAIN_TIMEOUT=900
