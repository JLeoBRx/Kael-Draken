# ─────────────────────────────────────────────────────────────
# Kael Draken — O Arquivo da Chama Antiga
# Copie este arquivo para .env.local e preencha os valores.
# Nunca envie .env.local para o repositório.
# ─────────────────────────────────────────────────────────────

# Endereço público do site (usado em SEO, sitemap e Open Graph).
SITE_URL=http://localhost:3000

# Banco de dados (libSQL / SQLite).
# Local: arquivo SQLite dentro de ./data
# Remoto (opcional): libsql://<banco>.turso.io  + DATABASE_AUTH_TOKEN
DATABASE_URL=file:./data/kael-draken.db
DATABASE_AUTH_TOKEN=

# Pasta onde as imagens enviadas pelo painel são guardadas.
# Precisa ser um disco persistente em produção.
UPLOADS_DIR=./data/uploads
# Tamanho máximo por imagem, em megabytes.
MAX_UPLOAD_MB=25

# ── Painel administrativo ────────────────────────────────────
# Usuário de acesso ao painel.
ADMIN_USERNAME=
# Hash da senha (NUNCA a senha em texto). Gere com:
#   npm run admin:hash
ADMIN_PASSWORD_HASH=
# Segredo usado para assinar a sessão (mínimo de 32 caracteres aleatórios). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
